# Preferred (Cloud Agent / secrets): paste the full service-account JSON key
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Alternative (local file path) if you prefer not to inline the JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Google account used to SIGN IN to the IntouchCX form (required for live submits)
GOOGLE_SIGNIN_EMAIL=hrcareers@olympuz-org.com
# Set as a Cursor / environment SECRET only — never commit the real password
GOOGLE_SIGNIN_PASSWORD=

# Optional: Playwright storage_state JSON from a trusted signed-in browser
# (use this if Google blocks unrecognized-device 2FA in the cloud VM)
# GOOGLE_STORAGE_STATE_JSON={"cookies":[...],"origins":[...]}

# Optional overrides
INTOUCH_SPREADSHEET_ID=1NoRX955F0dpxMReiC-6lcd3hgxFDccS3H9hzabTQghE
INTOUCH_SHEET_GID=112514731

# Keep "1" for dry-run. Set to "0" only when enabling live submissions via env.
INTOUCH_DRY_RUN=1
